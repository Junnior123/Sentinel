{
  "name": "sentinel",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "local": "tsx scripts/dev-server.ts",
    "samples": "node scripts/fetch-samples.mjs",
    "test:web": "node scripts/web-smoke.mjs && node scripts/invitation-smoke.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply watchblock --local",
    "deploy": "npm run check:production && npm run build && wrangler deploy --config wrangler.production.json",
    "setup:production": "node scripts/configure-production.mjs",
    "check:production": "node scripts/check-production.mjs",
    "db:production": "npm run check:production && wrangler d1 migrations apply watchblock --remote --config wrangler.production.json"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251008.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "playwright": "1.56.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.4.1",
    "wrangler": "4.45.0"
  }
}
