<Window x:Class="Watchblock.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Watchblock.App" Title="Sentinel" Width="1180" Height="780" WindowStartupLocation="CenterScreen" MinWidth="980" MinHeight="680" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><local:Labels x:Key="Labels"/></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="26,0" Background="{DynamicResource Inset}"><DockPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Accent}" CornerRadius="9" Width="30" Height="30" Margin="0,0,10,0"><Path Data="M 8,2 L 15,5 L 15,11 C 15,17 8,20 8,20 C 8,20 1,17 1,11 L 1,5 Z M 4,10 L 7,13 L 12,7" Stroke="{DynamicResource AccentInk}" StrokeThickness="1.4" Stretch="Uniform" Width="15" Height="19"/></Border><TextBlock Text="sentinel" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><Button x:Name="ThemeToggle" Content="☼  화이트 모드" Click="Theme_Click" AutomationProperties.Name="테마 전환" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/></DockPanel></Border>
 <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="26,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><UniformGrid Columns="4" MaxWidth="760" HorizontalAlignment="Left"><Border x:Name="StepFrame1" CornerRadius="7" Padding="16,10" Margin="0,0,8,0"><TextBlock x:Name="Step1" Text="01   검사 연결"/></Border><Border x:Name="StepFrame2" CornerRadius="7" Padding="16,10" Margin="0,0,8,0"><TextBlock x:Name="Step2" Text="02   범위 확인"/></Border><Border x:Name="StepFrame3" CornerRadius="7" Padding="16,10" Margin="0,0,8,0"><TextBlock x:Name="Step3" Text="03   검사 진행"/></Border><Border x:Name="StepFrame4" CornerRadius="7" Padding="16,10"><TextBlock x:Name="Step4" Text="04   결과 제출"/></Border></UniformGrid><TextBlock Grid.Column="1" x:Name="ConnectedService" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" MaxWidth="210" TextTrimming="CharacterEllipsis"/></Grid></Border>
 <Grid Grid.Row="1" Margin="26,22" x:Name="FlowContent">
 <ScrollViewer x:Name="Setup" VerticalScrollBarVisibility="Auto"><StackPanel>
 <StackPanel x:Name="WelcomePane" Margin="0,6" HorizontalAlignment="Stretch">
 <TextBlock Text="검사 연결" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="WelcomeSubtitle" Text="운영자에게 받은 초대 링크를 붙여넣으세요." Foreground="{DynamicResource Muted}" Margin="0,12,0,25"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Panel}" CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="26"><StackPanel>
 <TextBlock x:Name="CodeLabel" Text="검사 초대 링크 또는 코드" FontWeight="SemiBold"/><TextBox x:Name="Code" FontSize="18" MaxLength="4096" AutomationProperties.Name="검사 초대 링크 또는 코드" TextChanged="Invitation_Changed"/>
 <TextBlock x:Name="InvitationPreview" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,0,16" Text="연결할 서버를 확인하세요."/>
 <Button x:Name="ConnectButton" Content="연결하고 계속  →" Click="Connect_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Stretch"/>
 <Button Content="초대 파일 열기" Click="ImportInvitation_Click" Margin="0,12,0,0"/>
 </StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="24"><StackPanel><TextBlock Text="검사 순서" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,26"/><TextBlock Text="01   초대 연결" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/><TextBlock Text="운영자가 보낸 링크 또는 코드" Foreground="{DynamicResource Muted}" FontSize="12" Margin="30,6,0,24"/><TextBlock Text="02   위치 선택 후 검사" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/><TextBlock Text="제외할 폴더와 수집 항목 확인" Foreground="{DynamicResource Muted}" FontSize="12" Margin="30,6,0,24"/><TextBlock Text="03   자동 제출 · 결과 확인" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/><TextBlock Text="검사 완료 후 운영자에게 자동 전송" Foreground="{DynamicResource Muted}" FontSize="12" Margin="30,6,0,0"/></StackPanel></Border></Grid>
 <Expander x:Name="ConnectionPanel" Header="코드만 받은 경우 · 연결 설정" IsExpanded="False" Foreground="{DynamicResource Muted}" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="운영자 서버"/><TextBox x:Name="Server" AutomationProperties.Name="운영자 서버" TextChanged="Invitation_Changed"/><TextBlock Text="서버 전용 앱은 주소 입력 없이 코드만 사용할 수 있습니다." TextWrapping="Wrap" FontSize="12"/></StackPanel></Expander>
 </StackPanel>
 <Grid x:Name="ConsentPane" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock Text="검사 범위" FontSize="26" FontWeight="Bold" Margin="0,0,0,18"/>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="18" MinHeight="370"><StackPanel x:Name="Options" IsEnabled="False">
 <TextBlock Text="검사 위치" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ScopeDescription" Text="검사 폴더를 선택하세요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18"/>
 <ListBox x:Name="Roots" Height="112" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" Foreground="{DynamicResource Ink}" SelectionChanged="Scope_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="6"/></DataTemplate></ListBox.ItemTemplate></ListBox>
 <WrapPanel Margin="0,12,0,8"><Button Content="폴더 추가" Click="AddFolder_Click"/><Button x:Name="RecommendedButton" Content="권장 C 드라이브" Click="Recommended_Click" Visibility="Collapsed"/><Button x:Name="AddDrivesButton" Content="전체 드라이브" Click="AddDrives_Click" Visibility="Collapsed"/><Button Content="제거" Click="RemoveFolder_Click"/></WrapPanel>
 <CheckBox x:Name="SkipSystemStores" Content="게임 데이터·드라이버·임시 저장소 제외" IsChecked="True" Checked="Exclusions_Changed" Unchecked="Exclusions_Changed" Margin="0,0,0,12" ToolTip="제외 위치 펼치기에서 목록을 확인할 수 있습니다. 해제하면 해당 위치도 검사합니다."/><Expander Header="제외 위치 보기" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"><TextBlock x:Name="ExclusionList" TextWrapping="Wrap" FontSize="11" Margin="4,8"/></Expander><CheckBox x:Name="DeletedHistory" Content="휴지통·최근 삭제 기록 확인" IsChecked="True" Checked="Exclusions_Changed" Unchecked="Exclusions_Changed" ToolTip="현재 사용자 휴지통과 최근 7일의 잔존 NTFS 삭제 기록을 확인합니다. 비운 휴지통 기록에는 관리자 권한이 필요합니다. 파일 검사 제외 폴더도 기록에는 포함됩니다."/><CheckBox x:Name="Elevate" Content="실행 흔적 확인에 관리자 권한 사용"/>
 <TextBlock Text="숨겨진 항목도 검사합니다. 권한 부족·크기 제한은 결과에 표시됩니다." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/>
 </StackPanel></Border>
 <StackPanel Grid.Column="2"><Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="검사 요청" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock x:Name="SessionInfo" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" FontSize="13" LineHeight="22"/></StackPanel></Border>
 <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,20,0,0"><StackPanel><TextBlock Text="공유할 정보" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock x:Name="ConsentInfo" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" LineHeight="20"/><CheckBox x:Name="Consent" Checked="Scope_Changed" Unchecked="Scope_Changed" Margin="0,22,0,0"><TextBlock Text="검사 범위와 완료 후 보고서 자동 제출에 동의합니다" TextWrapping="Wrap"/></CheckBox></StackPanel></Border>
 </StackPanel></Grid></Grid>
 </StackPanel></ScrollViewer>
 <Grid x:Name="ProgressPane" Visibility="Collapsed" VerticalAlignment="Center" Margin="32,0"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Width="198" Height="180" CornerRadius="28" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" AutomationProperties.Name="파일을 검사하는 폴더와 돋보기"><Viewbox Width="133" Height="115"><Canvas Width="148" Height="128"><Path Data="M 14,36 L 14,29 Q 14,23 21,23 L 51,23 L 61,32 L 123,32 Q 130,32 130,39 L 130,46" Stroke="{DynamicResource Muted}" StrokeThickness="3" StrokeLineJoin="Round"/><Path Data="M 13,42 Q 13,36 20,36 L 129,36 Q 137,36 135,44 L 125,97 Q 124,103 117,103 L 29,103 Q 22,103 21,96 Z" Fill="{DynamicResource Raised}" Stroke="{DynamicResource Muted}" StrokeThickness="3" StrokeLineJoin="Round"/><Ellipse Canvas.Left="72" Canvas.Top="57" Width="43" Height="43" Fill="{DynamicResource Panel}" Stroke="{DynamicResource Ink}" StrokeThickness="4"/><Path Data="M 109,94 L 132,118" Stroke="{DynamicResource Ink}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
 <StackPanel Grid.Column="2"><TextBlock Text="검사 진행" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/><TextBlock x:Name="ProgressTitle" Text="검사 준비" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProgressPercent" FontSize="64" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,8,0,6"/><TextBlock x:Name="ProgressCount" Foreground="{DynamicResource Muted}" Margin="0,0,0,22"/><ProgressBar x:Name="ScanActivity" Height="8" Foreground="{DynamicResource Ink}" Background="{DynamicResource Raised}"/><TextBlock x:Name="ProgressEta" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,18,0,0"/><TextBlock Text="취소하면 완료된 파일의 결과를 보관할 수 있습니다." Foreground="{DynamicResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,30,0,0"/></StackPanel>
 </Grid>
 <Grid x:Name="ResultPane" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock x:Name="ResultTitle" Text="검사 결과" FontSize="25" FontWeight="Bold" TextWrapping="Wrap"/>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,4"><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="검사 파일" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="MetricFiles" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,10,0,0"/></StackPanel></Border><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="치트 일치" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="MetricKnown" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" Margin="0,10,0,0"/></StackPanel></Border><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="검토 필요" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="MetricReview" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" Margin="0,10,0,0"/></StackPanel></Border><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="누락·제한" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="MetricCoverage" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
 <TextBlock x:Name="ResultSummary" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,14"/>
  <TabControl x:Name="ResultTabs" Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}">
 <TabItem Header="파일 목록"><DataGrid x:Name="Files" RowDetailsVisibilityMode="VisibleWhenSelected"><DataGrid.Columns><DataGridTextColumn Header="파일 · 선택하면 상세 표시" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="형식" Binding="{Binding Format}" Width="90"/><DataGridTextColumn Header="상태" Binding="{Binding Status, Converter={StaticResource Labels}}" Width="80"/></DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><Border Background="{DynamicResource Raised}" Padding="14"><StackPanel><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/><TextBlock Text="SHA-256" Foreground="{DynamicResource Muted}" Margin="0,8,0,3"/><TextBlock Text="{Binding Sha256}" TextWrapping="Wrap"/><TextBlock Text="{Binding HashReason}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}"/><TextBlock Text="{Binding Signature}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid></TabItem>
 <TabItem Header="탐지 근거"><DataGrid x:Name="Findings" RowDetailsVisibilityMode="VisibleWhenSelected"><DataGrid.Columns><DataGridTextColumn Header="분류" Binding="{Binding Category, Converter={StaticResource Labels}}" Width="90"/><DataGridTextColumn Header="항목 · 선택하면 근거 표시" Binding="{Binding Title}" Width="*"/></DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><Border Background="{DynamicResource Raised}" Padding="14"><StackPanel><TextBlock Text="{Binding RuleId}" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid></TabItem>
 <TabItem Header="실행·삭제 흔적"><DataGrid x:Name="Artifacts" RowDetailsVisibilityMode="VisibleWhenSelected"><DataGrid.RowDetailsTemplate><DataTemplate><Border Background="{DynamicResource Raised}" Padding="14"><StackPanel><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/><TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" Margin="0,6"/><TextBlock Text="{Binding Note}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate><DataGrid.Columns><DataGridTextColumn Header="출처" Binding="{Binding Source, Converter={StaticResource Labels}}" Width="100"/><DataGridTextColumn Header="연결" Binding="{Binding Association, Converter={StaticResource Labels}}" Width="100"/><DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="155"/><DataGridTextColumn Header="파일" Binding="{Binding Path}" Width="180"/><DataGridTextColumn Header="근거" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
 <TabItem Header="검사 범위"><DataGrid x:Name="Coverage"><DataGrid.Columns><DataGridTextColumn Header="검사" Binding="{Binding Collector, Converter={StaticResource Labels}}" Width="75"/><DataGridTextColumn Header="상태" Binding="{Binding Status, Converter={StaticResource Labels}}" Width="75"/><DataGridTextColumn Header="설명" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
 </TabControl>
 </Grid>
 </Grid></Grid>
 <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Inset}" Padding="20,12"><StackPanel><TextBlock x:Name="Status" Text="운영자에게 받은 검사 초대를 준비해 주세요." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/><DockPanel>
 <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ScanButton" Content="동의하고 검사 시작  →" Visibility="Collapsed" IsEnabled="False" Click="Scan_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}"/><Button x:Name="SubmitButton" Content="제출 다시 시도  →" Visibility="Collapsed" IsEnabled="False" Click="Submit_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}"/></StackPanel>
 <WrapPanel><Button x:Name="CancelButton" Content="검사 취소" Visibility="Collapsed" IsEnabled="False" Click="Cancel_Click"/><Button x:Name="ExportButton" Content="보고서 저장" Visibility="Collapsed" IsEnabled="False" Click="Export_Click"/><Button x:Name="DeclineButton" Content="제출하지 않기" Visibility="Collapsed" IsEnabled="False" Click="Decline_Click"/><Button x:Name="DeleteButton" Content="서버 보고서 삭제" Visibility="Collapsed" IsEnabled="False" Click="Delete_Click"/></WrapPanel>
 </DockPanel></StackPanel></Border>
 </Grid>
</Window>
